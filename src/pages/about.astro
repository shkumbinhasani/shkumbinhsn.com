---
import PageLayout from "@/layouts/Base";

const meta = {
	title: "About",
	description: "About Shkumbin Hasani - Full Stack Software Engineer from Kosovo",
};
---

<PageLayout meta={meta}>
	<section class="section-spacing">
		<h1 class="mb-8 text-3xl font-semibold md:text-4xl">About me</h1>
		
		<div class="max-w-2xl space-y-6 text-textMuted">
			<p>
				I'm a software engineer based in Podujeve, Kosovo. Currently Founder at{" "}
				<a
					href="https://plutolaboratories.com"
					class="text-textColor hover:text-accent"
					target="_blank"
					rel="noopener noreferrer">Pluto Labs LLC</a
				>.
			</p>
			
			<p>
				Self-taught developer with 9+ years of experience building with code. 
				Started programming in 9th grade and haven't stopped since.
			</p>
			
			<p>
				My current stack centers around TypeScript, React, Node.js, and AWS. 
				I care deeply about writing clean, maintainable code and building systems that scale.
			</p>
			
			<p>
				Beyond engineering, I'm interested in entrepreneurship and building products 
				that solve real problems. Always working on something on the side.
			</p>
		</div>
	</section>

	<section class="section-spacing border-t border-borderColor">
		<h2 class="mb-8 text-2xl font-semibold">Get in touch</h2>
		<p class="mb-6 text-textMuted">
			Interested in working together? Feel free to reach out.
		</p>
		<a href="mailto:contact@shkumbinhsn.com" class="btn-primary">
			Send an email
		</a>
	</section>
</PageLayout>
