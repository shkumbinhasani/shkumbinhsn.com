---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/Base";
import { sortMDByDate } from "@/utils";

const MAX_POSTS = 4;
const allPosts = await getCollection("post");
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);

const expertise = [
	{
		title: "Full-Stack Development",
		description: "Building end-to-end applications with TypeScript, React, and Node.js that scale.",
	},
	{
		title: "Cloud Infrastructure",
		description: "Designing and deploying on AWS with focus on reliability and cost efficiency.",
	},
	{
		title: "Mobile Development",
		description: "Creating cross-platform mobile apps with React Native that feel native.",
	},
];

const companies = ["Pluto Labs LLC"];
---

<PageLayout meta={{ title: "Home" }}>
	<!-- Hero Section - Above the fold -->
	<section class="flex min-h-[70vh] flex-col justify-center py-12">
		<p class="mb-4 text-sm font-medium text-accent">Software Engineer</p>
		<h1 class="mb-6 text-4xl font-semibold leading-tight tracking-tight md:text-5xl lg:text-6xl">
			I build software that <br />
			<span class="text-textMuted">works and scales.</span>
		</h1>
		<p class="mb-8 max-w-xl text-lg text-textMuted">
			Full-stack engineer based in Kosovo with 9+ years of experience turning ideas into production-ready applications.
		</p>
		<div class="flex flex-wrap gap-4">
			<a href="mailto:contact@shkumbinhsn.com" class="btn-primary">
				Get in touch
			</a>
			<a href="/posts/" class="btn-secondary">
				Read my writing
			</a>
		</div>
	</section>

	<!-- Social Proof -->
	<section class="border-y border-borderColor py-8">
		<p class="text-sm text-textMuted">
			Currently building at <span class="font-medium text-textColor">{companies[0]}</span>
		</p>
	</section>

	<!-- Value Props - 3 cards max -->
	<section class="section-spacing">
		<h2 class="mb-12 text-2xl font-semibold">What I do</h2>
		<div class="grid gap-8 md:grid-cols-3">
			{
				expertise.map(({ title, description }) => (
					<div class="space-y-3">
						<h3 class="font-medium text-textColor">{title}</h3>
						<p class="text-sm text-textMuted">{description}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- Recent Writing -->
	<section class="section-spacing border-t border-borderColor">
		<div class="mb-12 flex items-center justify-between">
			<h2 class="text-2xl font-semibold">Recent writing</h2>
			<a href="/posts/" class="text-sm text-textMuted transition-colors hover:text-accent">
				View all
			</a>
		</div>
		<div class="space-y-8">
			{
				allPostsByDate.map((post) => (
					<article class="group">
						<a href={`/posts/${post.id}/`} class="block">
							<h3 class="mb-2 font-medium text-textColor transition-colors group-hover:text-accent">
								{post.data.title}
							</h3>
							<p class="mb-2 text-sm text-textMuted line-clamp-2">
								{post.data.description}
							</p>
							<time class="text-xs text-textMuted">
								{new Date(post.data.publishDate).toLocaleDateString("en-GB", {
									day: "numeric",
									month: "short",
									year: "numeric",
								})}
							</time>
						</a>
					</article>
				))
			}
		</div>
	</section>

	<!-- Final CTA -->
	<section class="section-spacing border-t border-borderColor text-center">
		<h2 class="mb-4 text-2xl font-semibold">Let's work together</h2>
		<p class="mb-8 text-textMuted">
			Have a project in mind? I'd love to hear about it.
		</p>
		<a href="mailto:contact@shkumbinhsn.com" class="btn-primary">
			Get in touch
		</a>
		<p class="mt-4 text-xs text-textMuted">
			Usually reply within 24 hours.
		</p>
	</section>
</PageLayout>
