---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/Base";
import PostPreview from "@/components/blog/PostPreview";
import XpIcon from "@/components/XpIcon";
import { sortMDByDate } from "@/utils";

const MAX_POSTS = 4;
const allPosts = await getCollection("post");
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);

const expertise = [
	{
		title: "Full-Stack Development",
		description: "Building end-to-end applications with TypeScript, React, and Node.js that scale.",
	},
	{
		title: "Cloud Infrastructure",
		description: "Designing and deploying on AWS with focus on reliability and cost efficiency.",
	},
	{
		title: "Mobile Development",
		description: "Creating cross-platform mobile apps with React Native that feel native.",
	},
];

const companies = ["Pluto Labs LLC"];
---

<PageLayout meta={{ title: "Home" }}>
	<div class="grid gap-6 py-4 lg:grid-cols-[220px_1fr] lg:gap-8">
		<!-- Explorer-style task pane -->
		<aside class="xp-pane-strip order-2 self-start lg:sticky lg:top-12 lg:order-1">
			<section class="xp-pane">
				<h2 class="xp-pane-head">System Tasks</h2>
				<ul class="xp-pane-body space-y-1.5">
					<li class="flex items-center gap-1.5">
						<XpIcon name="email" class="h-4 w-4" />
						<a href="mailto:contact@shkumbinhsn.com">Get in touch</a>
					</li>
					<li class="flex items-center gap-1.5">
						<XpIcon name="folder" class="h-4 w-4" />
						<a href="/posts/" data-astro-prefetch>Read my writing</a>
					</li>
					<li class="flex items-center gap-1.5">
						<XpIcon name="user" class="h-4 w-4" />
						<a href="/about/" data-astro-prefetch>About me</a>
					</li>
				</ul>
			</section>

			<section class="xp-pane">
				<h2 class="xp-pane-head">Details</h2>
				<dl class="xp-pane-body space-y-1">
					<div>
						<dt class="font-bold">Shkumbin Hasani</dt>
						<dd>Principal Engineer</dd>
					</div>
					<div>
						<dt class="font-bold">Location</dt>
						<dd>Kosovo</dd>
					</div>
					<div>
						<dt class="font-bold">Experience</dt>
						<dd>9+ years</dd>
					</div>
					<div>
						<dt class="font-bold">Working at</dt>
						<dd>
							ANON Labs AI, building{" "}
							<a href="https://serus.ai" target="_blank" rel="noopener noreferrer">Serus.ai</a>
						</dd>
					</div>
					<div>
						<dt class="font-bold">Founder of</dt>
						<dd><a href="https://plutolaboratories.com">Pluto Labs</a></dd>
					</div>
				</dl>
			</section>
		</aside>

		<div class="order-1 space-y-8 lg:order-2">
			<!-- Hero -->
			<section class="pt-2">
				<h1 class="mb-3 text-2xl leading-tight font-bold md:text-4xl">
					I build software that <br />
					<span class="text-textMuted">works and scales.</span>
				</h1>
				<p class="text-textMuted mb-5 max-w-xl text-sm md:text-base">
					Principal Engineer at ANON Labs AI, building{" "}
					<a href="https://serus.ai" class="xp-link" target="_blank" rel="noopener noreferrer"
						>Serus.ai</a
					>. Founder of{" "}
					<a
						href="https://plutolaboratories.com"
						class="xp-link"
						target="_blank"
						rel="noopener noreferrer">Pluto Labs</a
					>, where I ship side projects and help others ship theirs.
				</p>
				<div class="flex flex-wrap items-center gap-2">
					<a href="mailto:contact@shkumbinhsn.com" class="btn-primary">Get in touch</a>
					<a href="/posts/" class="btn-secondary">Read my writing</a>
				</div>
				<div class="mt-6">
					<p class="xp-balloon">
						<strong>Tip:</strong> Usually reply within 24 hours.
					</p>
				</div>
			</section>

			<!-- What I do -->
			<section class="xp-group">
				<h2 class="xp-group-title">What I do</h2>
				<div class="grid gap-3 md:grid-cols-3">
					{
						expertise.map(({ title, description }) => (
							<div class="xp-pane">
								<h3 class="xp-pane-head">{title}</h3>
								<p class="xp-pane-body text-textColor">{description}</p>
							</div>
						))
					}
				</div>
			</section>

			<!-- Recent writing -->
			<section class="xp-group">
				<h2 class="xp-group-title">Recent writing</h2>
				<ul class="-mx-2 space-y-1">
					{
						allPostsByDate.map((post) => (
							<li>
								<PostPreview post={post} as="h3" withDesc />
							</li>
						))
					}
				</ul>
				<a
					href="/posts/"
					class="xp-link mt-3 inline-flex items-center gap-1 text-[11px]"
					data-astro-prefetch
				>
					<XpIcon name="folder" class="h-4 w-4" />
					View all posts
				</a>
			</section>
		</div>
	</div>
</PageLayout>
