---
import PageLayout from "@/layouts/Base";

const meta = {
	title: "Page not found",
	description: "The page you're looking for doesn't exist.",
};
---

<PageLayout meta={meta}>
	<section class="section-spacing flex flex-col items-center justify-center text-center">
		<p class="mb-2 text-6xl font-semibold text-accent">404</p>
		<h1 class="mb-4 text-2xl font-semibold">Page not found</h1>
		<p class="mb-8 text-textMuted">
			The page you're looking for doesn't exist or has been moved.
		</p>
		<a href="/" class="btn-primary">
			Back to home
		</a>
	</section>
</PageLayout>
