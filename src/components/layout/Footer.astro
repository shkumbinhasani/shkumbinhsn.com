---
import XpIcon from "../XpIcon.astro";
import { siteConfig } from "@/site-config";

const year = new Date().getFullYear();
---

<footer class="xp-statusbar">
	<span class="flex min-w-0 flex-1 items-center gap-1.5 truncate">
		<XpIcon name="page" class="h-4 w-4 shrink-0" />
		<span class="truncate">Done</span>
	</span>
	<span class="xp-statusbar-cell hidden sm:flex">&copy; {year} {siteConfig.author}</span>
	<span class="xp-statusbar-cell">
		<XpIcon name="globe" class="h-4 w-4 shrink-0" />
		<span>Internet</span>
	</span>
</footer>
