---
import ThemeToggle from "../ThemeToggle.astro";
import { menuLinks } from "@/site-config";

const url = new URL(Astro.request.url);
---

<script>
	let headerEl: HTMLElement;
	let menuButtonEl: HTMLButtonElement;
	let menuOpen = false;

	function toggleMobileMenu() {
		headerEl.classList.toggle("menu-open");
		menuOpen = !menuOpen;
		menuButtonEl.setAttribute("aria-expanded", menuOpen.toString());
	}

	document.addEventListener("DOMContentLoaded", () => {
		headerEl = document.getElementById("main-header")!;
		menuButtonEl = document.getElementById("toggle-navigation-menu") as HTMLButtonElement;
		menuButtonEl.addEventListener("click", toggleMobileMenu);
	});

	document.addEventListener("astro:after-swap", () => {
		if (menuOpen) toggleMobileMenu();
	});
</script>

<header
	id="main-header"
	class="group sticky top-0 z-50 flex items-center justify-between bg-bgColor/80 py-4 backdrop-blur-sm"
	transition:persist
>
	<a
		href="/"
		class="text-lg font-semibold tracking-tight text-textColor transition-colors hover:text-accent"
		aria-current={url.pathname === "/" ? "page" : false}
	>
		Shkumbin Hasani
	</a>

	<div class="flex items-center gap-6">
		<nav
			id="navigation-menu"
			class="absolute left-0 right-0 top-full hidden flex-col gap-4 bg-bgColor/95 p-6 backdrop-blur-sm group-[.menu-open]:flex md:static md:flex md:flex-row md:gap-8 md:bg-transparent md:p-0 md:backdrop-blur-none"
			aria-label="Main menu"
		>
			{
				menuLinks.map((link) => (
					<a
						href={link.path}
						class="text-sm text-textMuted transition-colors hover:text-textColor"
						aria-current={url.pathname === link.path ? "page" : false}
						data-astro-prefetch
					>
						{link.title}
					</a>
				))
			}
		</nav>

		<ThemeToggle />

		<button
			id="toggle-navigation-menu"
			class="relative h-6 w-6 md:hidden"
			type="button"
			aria-label="Open main menu"
			aria-expanded="false"
			aria-haspopup="menu"
		>
			<svg
				class="absolute inset-0 transition-all group-[.menu-open]:scale-0 group-[.menu-open]:opacity-0"
				aria-hidden="true"
				xmlns="http://www.w3.org/2000/svg"
				fill="none"
				viewBox="0 0 24 24"
				stroke-width="1.5"
				stroke="currentColor"
			>
				<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9h16.5m-16.5 6.75h16.5"></path>
			</svg>
			<svg
				class="absolute inset-0 scale-0 opacity-0 transition-all group-[.menu-open]:scale-100 group-[.menu-open]:opacity-100"
				aria-hidden="true"
				xmlns="http://www.w3.org/2000/svg"
				fill="none"
				viewBox="0 0 24 24"
				stroke-width="1.5"
				stroke="currentColor"
			>
				<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
			</svg>
		</button>
	</div>
</header>
