---
import ThemeToggle from "../ThemeToggle.astro";
import XpIcon from "../XpIcon.astro";
import { menuLinks, siteConfig } from "@/site-config";

const url = new URL(Astro.request.url);
const host = (Astro.site ?? url).host;
const address = `http://${host}${url.pathname}`;
---

{/* `contents` so the sticky title bar sticks to the window, not to the header's own box. */}
<header id="main-header" class="contents">
	<div class="xp-titlebar">
		<XpIcon name="window" class="h-4 w-4 shrink-0" />
		<span class="xp-titlebar-title">{siteConfig.title} - Microsoft Internet Explorer</span>
		<span class="flex shrink-0 items-center gap-0.5" aria-hidden="true">
			<span class="xp-titlebar-btn"><XpIcon name="min" class="h-3 w-3" /></span>
			<span class="xp-titlebar-btn"><XpIcon name="max" class="h-3 w-3" /></span>
			<a href="/" class="xp-titlebar-btn is-close ml-0.5" tabindex="-1" title="Close">
				<XpIcon name="close" class="h-3 w-3" />
			</a>
		</span>
	</div>

	<div class="xp-menubar">
		<nav id="navigation-menu" class="flex flex-wrap items-center" aria-label="Main menu">
			{
				menuLinks.map((link) => {
					const isActive =
						url.pathname === link.path || (link.path !== "/" && url.pathname.startsWith(link.path));
					return (
						<a
							href={link.path}
							class="xp-menu-item"
							aria-current={isActive ? "page" : "false"}
							data-astro-prefetch
						>
							{link.title}
						</a>
					);
				})
			}
			<a href="/rss.xml" class="xp-menu-item">RSS</a>
		</nav>
		<div class="ml-auto flex items-center">
			<ThemeToggle />
		</div>
	</div>

	<div class="xp-toolbar">
		<span class="xp-toolbar-grip" aria-hidden="true"></span>
		<span class="hidden sm:inline">Address</span>
		<span class="xp-textbox" aria-label="Current address">
			<XpIcon name="page" class="h-4 w-4 shrink-0" />
			<span class="truncate">{address}</span>
		</span>
		<a href={url.pathname} class="xp-btn xp-btn-sm gap-1" aria-label="Reload this page">
			<XpIcon name="arrow" class="h-4 w-4" />
			Go
		</a>
	</div>
</header>
