---
import type { PaginationLink } from "@/data/types";

interface Props {
	prevUrl?: PaginationLink;
	nextUrl?: PaginationLink;
}

const { prevUrl, nextUrl } = Astro.props;
---

{
	(prevUrl || nextUrl) && (
		<nav class="mt-6 flex items-center justify-between gap-2">
			{prevUrl ? (
				<a class="xp-btn gap-1" href={prevUrl.url} data-astro-prefetch>
					<span aria-hidden="true">&lt;</span>
					{prevUrl.srLabel && <span class="sr-only">{prevUrl.srLabel}</span>}
					{prevUrl.text || "Back"}
				</a>
			) : (
				<span />
			)}
			{nextUrl && (
				<a class="xp-btn gap-1" href={nextUrl.url} data-astro-prefetch>
					{nextUrl.srLabel && <span class="sr-only">{nextUrl.srLabel}</span>}
					{nextUrl.text || "Next"}
					<span aria-hidden="true">&gt;</span>
				</a>
			)}
		</nav>
	)
}
