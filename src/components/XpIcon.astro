---
/**
 * Small pixel-flavoured icons for the XP chrome. Everything is inline SVG so it
 * needs no assets and recolours with the theme.
 */
interface Props {
	name:
		| "window"
		| "page"
		| "folder"
		| "globe"
		| "error"
		| "info"
		| "close"
		| "min"
		| "max"
		| "search"
		| "arrow"
		| "user"
		| "email"
		| "sun"
		| "moon";
	class?: string;
}

const { name, class: className = "h-4 w-4" } = Astro.props;
---

{
	name === "window" && (
		<svg class={className} viewBox="0 0 16 16" aria-hidden="true" shape-rendering="crispEdges">
			<rect x="1" y="2" width="14" height="12" fill="#ece9d8" stroke="#0831d9" />
			<rect x="1" y="2" width="14" height="3" fill="#0855dd" />
			<rect x="12" y="3" width="2" height="1" fill="#d9573f" />
			<rect x="3" y="7" width="10" height="5" fill="#fff" stroke="#7f9db9" stroke-width="0.5" />
		</svg>
	)
}
{
	name === "page" && (
		<svg class={className} viewBox="0 0 16 16" aria-hidden="true" shape-rendering="crispEdges">
			<path d="M3 1h7l3 3v11H3z" fill="#fff" stroke="#8a8a8a" />
			<path d="M10 1v3h3" fill="#dcdcdc" stroke="#8a8a8a" />
			<rect x="5" y="6" width="6" height="1" fill="#6b6b6b" />
			<rect x="5" y="8" width="6" height="1" fill="#6b6b6b" />
			<rect x="5" y="10" width="4" height="1" fill="#6b6b6b" />
		</svg>
	)
}
{
	name === "folder" && (
		<svg class={className} viewBox="0 0 16 16" aria-hidden="true" shape-rendering="crispEdges">
			<path d="M1 4h5l1 1h8v9H1z" fill="#ffd45c" stroke="#c99a1e" />
			<path d="M1 7h14v7H1z" fill="#ffe18d" stroke="#c99a1e" />
		</svg>
	)
}
{
	name === "globe" && (
		<svg class={className} viewBox="0 0 16 16" aria-hidden="true">
			<circle cx="8" cy="8" r="6.5" fill="#3a8ee6" stroke="#1d4fa0" />
			<path
				d="M4 5.5c1.5-1 3-1 4 0s2.5 1 3.5 0M3.5 9.5c1.5.5 3 .5 4.5 0s3-.5 4.5 0"
				stroke="#7fd3a0"
				stroke-width="1.6"
				fill="none"
			/>
			<ellipse cx="8" cy="8" rx="3" ry="6.5" fill="none" stroke="#1d4fa0" stroke-width="0.7" />
			<path d="M1.5 8h13" stroke="#1d4fa0" stroke-width="0.7" />
		</svg>
	)
}
{
	name === "error" && (
		<svg class={className} viewBox="0 0 32 32" aria-hidden="true">
			<circle cx="16" cy="16" r="14" fill="url(#xp-err)" stroke="#7a0000" />
			<defs>
				<radialGradient id="xp-err" cx="35%" cy="30%" r="70%">
					<stop offset="0" stop-color="#ff8c8c" />
					<stop offset="0.6" stop-color="#e51e1e" />
					<stop offset="1" stop-color="#9a0000" />
				</radialGradient>
			</defs>
			<path d="M10 10l12 12M22 10L10 22" stroke="#fff" stroke-width="3.5" stroke-linecap="round" />
		</svg>
	)
}
{
	name === "info" && (
		<svg class={className} viewBox="0 0 32 32" aria-hidden="true">
			<circle cx="16" cy="16" r="14" fill="url(#xp-info)" stroke="#123b8a" />
			<defs>
				<radialGradient id="xp-info" cx="35%" cy="30%" r="70%">
					<stop offset="0" stop-color="#9ac6ff" />
					<stop offset="0.6" stop-color="#2f74d9" />
					<stop offset="1" stop-color="#123b8a" />
				</radialGradient>
			</defs>
			<circle cx="16" cy="9.5" r="2.2" fill="#fff" />
			<path d="M13 14h4.5v9H20v2h-8v-2h2.5v-7H13z" fill="#fff" />
		</svg>
	)
}
{
	name === "close" && (
		<svg class={className} viewBox="0 0 12 12" aria-hidden="true">
			<path
				d="M2 2l8 8M10 2l-8 8"
				stroke="currentColor"
				stroke-width="2.2"
				stroke-linecap="square"
			/>
		</svg>
	)
}
{
	name === "min" && (
		<svg class={className} viewBox="0 0 12 12" aria-hidden="true" shape-rendering="crispEdges">
			<rect x="2" y="8" width="6" height="2.5" fill="currentColor" />
		</svg>
	)
}
{
	name === "max" && (
		<svg class={className} viewBox="0 0 12 12" aria-hidden="true" shape-rendering="crispEdges">
			<rect
				x="1.5"
				y="1.5"
				width="9"
				height="9"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
			/>
			<rect x="1.5" y="1.5" width="9" height="2.5" fill="currentColor" />
		</svg>
	)
}
{
	name === "search" && (
		<svg class={className} viewBox="0 0 16 16" aria-hidden="true">
			<circle cx="6.5" cy="6.5" r="4.5" fill="#dff1ff" stroke="#2b5fb5" stroke-width="1.5" />
			<path d="M10 10l4.5 4.5" stroke="#6b4a1f" stroke-width="2.5" stroke-linecap="round" />
		</svg>
	)
}
{
	name === "arrow" && (
		<svg class={className} viewBox="0 0 16 16" aria-hidden="true">
			<path
				d="M2 8h9M8 4l4 4-4 4"
				fill="none"
				stroke="#3a8a3a"
				stroke-width="2.2"
				stroke-linecap="round"
				stroke-linejoin="round"
			/>
		</svg>
	)
}
{
	name === "user" && (
		<svg class={className} viewBox="0 0 16 16" aria-hidden="true">
			<circle cx="8" cy="5" r="3.2" fill="#f7c58e" stroke="#9a5a1e" stroke-width="0.8" />
			<path
				d="M2 15c0-3.5 2.7-5.5 6-5.5s6 2 6 5.5z"
				fill="#3a8ee6"
				stroke="#1d4fa0"
				stroke-width="0.8"
			/>
		</svg>
	)
}
{
	name === "email" && (
		<svg class={className} viewBox="0 0 16 16" aria-hidden="true" shape-rendering="crispEdges">
			<rect x="1" y="3" width="14" height="10" fill="#fff" stroke="#7f9db9" />
			<path d="M1 3l7 6 7-6" fill="none" stroke="#7f9db9" />
		</svg>
	)
}
{
	name === "sun" && (
		<svg class={className} viewBox="0 0 16 16" aria-hidden="true">
			<circle cx="8" cy="8" r="3.2" fill="#ffd000" stroke="#c98a00" />
			<path
				d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6L13 13M3 13l1.4-1.4M11.6 4.4L13 3"
				stroke="#e0a000"
				stroke-width="1.4"
				stroke-linecap="round"
			/>
		</svg>
	)
}
{
	name === "moon" && (
		<svg class={className} viewBox="0 0 16 16" aria-hidden="true">
			<path d="M10.5 2a6 6 0 1 0 3.5 9.5A5 5 0 0 1 10.5 2z" fill="#f4f0b8" stroke="#8a8250" />
		</svg>
	)
}
