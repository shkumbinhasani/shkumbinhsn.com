---
import type { MarkdownHeading } from "astro";

import { generateToc } from "src/utils/generateToc";
import TOCHeading from "./TOCHeading.astro";

interface Props {
	headings: Array<MarkdownHeading>;
}

const { headings } = Astro.props;

const toc = generateToc(headings);
---

{
	/* Posts written with h1 section headings produce no h2 entries; skip the empty pane. */
	toc.length > 0 && (
		<aside class="xp-pane-strip sticky top-12 order-2 mb-6 hidden w-56 shrink-0 self-start lg:mb-0 lg:block">
			<section class="xp-pane">
				<h2 class="xp-pane-head">On this page</h2>
				<ul class="xp-pane-body space-y-1">
					{toc.map((heading) => (
						<TOCHeading heading={heading} />
					))}
				</ul>
			</section>
		</aside>
	)
}
