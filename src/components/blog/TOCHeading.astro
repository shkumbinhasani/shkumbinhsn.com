---
import type { TocItem } from "@/utils";

interface Props {
	heading: TocItem;
}

const {
	heading: { slug, text, depth, subheadings },
} = Astro.props;
---

<li class={depth > 2 ? "ml-3" : ""}>
	<a class="line-clamp-2 block py-0.5" href={`#${slug}`} aria-label={`Scroll to section: ${text}`}>
		{text}
	</a>
	{
		!!subheadings.length && (
			<ul>
				{subheadings.map((subheading) => (
					<Astro.self heading={subheading} />
				))}
			</ul>
		)
	}
</li>
