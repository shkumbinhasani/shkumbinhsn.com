---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "../FormattedDate.astro";
import XpIcon from "../XpIcon.astro";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
	withDesc?: boolean;
};

const { post, as: Tag = "div", withDesc = false } = Astro.props;
const postDate = post.data.updatedDate ?? post.data.publishDate;
---

<article>
	<a href={`/posts/${post.id}/`} class="xp-file group text-textColor" data-astro-prefetch>
		<XpIcon name="page" class="xp-file-icon" />
		<span class="min-w-0">
			<Tag class="mb-0.5 text-sm font-bold group-hover:underline">
				{post.data.title}
			</Tag>
			{
				withDesc && (
					<p class="text-textMuted mb-1 line-clamp-2 text-[12px]">{post.data.description}</p>
				)
			}
			<span class="text-textMuted flex flex-wrap gap-x-3 text-[11px]">
				<span>Type: Blog post</span>
				<span>Date modified: <FormattedDate date={postDate} /></span>
			</span>
		</span>
	</a>
</article>
