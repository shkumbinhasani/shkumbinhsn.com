---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "../FormattedDate.astro";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
	withDesc?: boolean;
};

const { post, as: Tag = "div", withDesc = false } = Astro.props;
const postDate = post.data.updatedDate ?? post.data.publishDate;
---

<article class="group">
	<a href={`/posts/${post.id}/`} class="block" data-astro-prefetch>
		<Tag class="mb-2 font-medium text-textColor transition-colors group-hover:text-accent">
			{post.data.title}
		</Tag>
		{withDesc && (
			<p class="mb-2 text-sm text-textMuted line-clamp-2">
				{post.data.description}
			</p>
		)}
		<FormattedDate date={postDate} class="text-xs text-textMuted" />
	</a>
</article>
