---
/**
 * Interactive screenshot comparison.
 *
 * Switches between the three apps and the three viewports with no JavaScript —
 * real radio inputs plus `:has()` do the work, so it is keyboard accessible and
 * works before (and without) hydration.
 *
 * Images live in `public/screenshots/<round>/<app>-<viewport>.jpg`.
 */
interface Props {
	round: string;
	title?: string;
	/** Optional per-pane annotation, keyed "app-viewport", e.g. { "css-mobile": "314px of overflow" } */
	notes?: Record<string, string>;
}

const { round, title, notes = {} } = Astro.props;

const apps = [
	{ id: "css", label: "Plain CSS" },
	{ id: "tailwind", label: "Tailwind" },
	{ id: "stylex", label: "StyleX" },
];

const viewports = [
	{ id: "desktop", label: "Desktop", px: "1440px" },
	{ id: "tablet", label: "Tablet", px: "834px" },
	{ id: "mobile", label: "Mobile", px: "390px" },
];

const uid = round.replace(/[^a-z0-9]/gi, "");
---

<figure class="sv my-8 not-prose">
	<div
		class="overflow-hidden rounded-lg border border-borderColor bg-[hsl(var(--theme-bg))]"
	>
		{
			title && (
				<p class="border-b border-borderColor px-4 py-2 text-xs font-medium tracking-wide text-textMuted uppercase">
					{title}
				</p>
			)
		}

		<div class="flex flex-wrap gap-4 border-b border-borderColor px-4 py-3">
			<fieldset class="flex items-center gap-1">
				<legend class="sr-only">Styling tool</legend>
				{
					apps.map((app, i) => (
						<label class="sv-pill">
							<input
								class="sr-only"
								type="radio"
								name={`${uid}-app`}
								value={app.id}
								checked={i === 0}
							/>
							<span>{app.label}</span>
						</label>
					))
				}
			</fieldset>

			<fieldset class="flex items-center gap-1 sm:ml-auto">
				<legend class="sr-only">Viewport</legend>
				{
					viewports.map((vp, i) => (
						<label class="sv-pill">
							<input
								class="sr-only"
								type="radio"
								name={`${uid}-vp`}
								value={vp.id}
								checked={i === 0}
							/>
							<span>
								{vp.label}
								<span class="sv-px"> {vp.px}</span>
							</span>
						</label>
					))
				}
			</fieldset>
		</div>

		<div class="sv-stage bg-[hsl(var(--theme-border)/0.35)] p-4">
			<div class="sv-frame mx-auto">
				{
					apps.map((app, ai) =>
						viewports.map((vp, vi) => {
							const key = `${app.id}-${vp.id}`;
							const isDefault = ai === 0 && vi === 0;
							return (
								<div class="sv-shot" data-app={app.id} data-vp={vp.id}>
									{notes[key] && <p class="sv-note">{notes[key]}</p>}
									<div class="sv-scroll">
										<img
											src={`/screenshots/${round}/${key}.jpg`}
											alt={`${app.label} at ${vp.label} width`}
											loading={isDefault ? "eager" : "lazy"}
											decoding="async"
										/>
									</div>
								</div>
							);
						}),
					)
				}
			</div>
		</div>
	</div>

	<figcaption class="mt-2 text-center text-xs text-textMuted">
		Pick a styling tool and a viewport. Each pane scrolls the full page.
	</figcaption>
</figure>

<script>
	/**
	 * Switching is pure CSS; this only nudges lazy images.
	 *
	 * Hidden panes use `display: none`, and a browser will not fetch a lazy image
	 * inside a `display: none` subtree — so a pane revealed by the radios can sit
	 * there permanently blank. On each change, promote the newly visible image to
	 * eager so it actually loads.
	 */
	function wakeVisibleImage(viewer: Element) {
		const shot = Array.from(viewer.querySelectorAll<HTMLElement>(".sv-shot")).find(
			(el) => getComputedStyle(el).display !== "none",
		);
		const img = shot?.querySelector("img");
		if (img && !img.complete) img.loading = "eager";
	}

	for (const viewer of document.querySelectorAll(".sv")) {
		viewer.addEventListener("change", () => wakeVisibleImage(viewer));
	}
</script>

<style is:global>
	/* --- pane switching: a shot is visible only when it matches BOTH radios --- */
	.sv .sv-shot {
		display: block;
	}
	.sv:has(input[value="css"]:checked) .sv-shot:not([data-app="css"]),
	.sv:has(input[value="tailwind"]:checked) .sv-shot:not([data-app="tailwind"]),
	.sv:has(input[value="stylex"]:checked) .sv-shot:not([data-app="stylex"]),
	.sv:has(input[value="desktop"]:checked) .sv-shot:not([data-vp="desktop"]),
	.sv:has(input[value="tablet"]:checked) .sv-shot:not([data-vp="tablet"]),
	.sv:has(input[value="mobile"]:checked) .sv-shot:not([data-vp="mobile"]) {
		display: none;
	}

	/* --- pane narrows to suggest the device ---
	   Sized off each shot's own data-vp rather than :has() on the wrapper: the
	   pane already knows its viewport, so this needs no cascade gymnastics. */
	.sv .sv-shot[data-vp="tablet"] .sv-scroll {
		max-width: 460px;
		margin-inline: auto;
	}
	.sv .sv-shot[data-vp="mobile"] .sv-scroll {
		max-width: 260px;
		margin-inline: auto;
	}

	/* Fixed height, not max-height: a lazy image has no intrinsic size until it
	   loads, and an auto-height pane would collapse to nothing in the meantime. */
	.sv .sv-scroll {
		height: 26rem;
		overflow-y: auto;
		overscroll-behavior: contain;
		border-radius: 0.375rem;
		border: 1px solid hsl(var(--theme-border));
		background: #fff;
	}
	.sv .sv-scroll img {
		display: block;
		width: 100%;
		height: auto;
	}

	/* --- pills --- */
	.sv .sv-pill {
		cursor: pointer;
	}
	.sv .sv-pill > span {
		display: inline-block;
		border-radius: 9999px;
		border: 1px solid hsl(var(--theme-border));
		padding: 0.25rem 0.7rem;
		font-size: 0.8125rem;
		line-height: 1.4;
		color: hsl(var(--theme-text-muted));
		transition:
			background-color 0.15s ease,
			color 0.15s ease,
			border-color 0.15s ease;
	}
	.sv .sv-pill:hover > span {
		border-color: hsl(var(--theme-accent));
		color: hsl(var(--theme-text));
	}
	.sv .sv-pill:has(input:checked) > span {
		border-color: hsl(var(--theme-accent));
		background: hsl(var(--theme-accent));
		color: hsl(var(--theme-bg));
		font-weight: 600;
	}
	.sv .sv-pill:has(input:focus-visible) > span {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 2px;
	}
	.sv .sv-px {
		opacity: 0.7;
		font-variant-numeric: tabular-nums;
	}
	.sv .sv-pill:has(input:checked) .sv-px {
		opacity: 0.85;
	}

	.sv .sv-note {
		margin: 0 0 0.5rem;
		border-radius: 0.375rem;
		background: hsl(0deg 70% 45% / 0.12);
		padding: 0.35rem 0.6rem;
		text-align: center;
		font-size: 0.75rem;
		font-weight: 600;
		color: hsl(0deg 70% 42%);
	}
	:root.dark .sv .sv-note {
		color: hsl(0deg 80% 72%);
	}
</style>
